{% if props.icon %}
  <div class="image">
    {% if props.url %}<a href="{{ props.url }}">{{ props.icon|raw }}</a>{% else %}{{ props.icon|raw }}{% endif %}
  </div>
{% endif %}
{% if props.has_label and props.label %}
  <div class="title"><h2>{{ props.label }}</h2></div>
{% endif %}
<div class="content"><div class="text body-style">
  <p>{{ props.text|raw }}</p>
  {% if props.url and props.link_title %}<a class="button" href="{{ props.url }}">{{ props.link_title }}</a>{% endif %}</p>
</div></div>
